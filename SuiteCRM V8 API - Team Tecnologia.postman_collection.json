            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"type\": \"AOS_Product_Categories\",\n    \"attributes\": {\n      \"name\": \"Herramientas Manuales\",\n      \"is_parent\": 1,\n      \"description\": \"Categoría principal para llaves, martillos y desarmadores\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{suitecrm_url}}/V8/module",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module"
              ]
