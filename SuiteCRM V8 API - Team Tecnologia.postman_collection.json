{
  "info": {
    "_postman_id": "57376667-6684-4d75-bc4f-1559d83f643b",
    "name": "SuiteCRM V8 API - Team Tecnologia (ERP Productos & Categorías)",
    "description": "Colección completa de la API V8 de SuiteCRM para el sistema ERP de Team Tecnología. Incluye módulos de Autenticación OAuth2, Productos (AOS_Products), Categorías y Subcategorías (AOS_Product_Categories) y Clientes (Accounts y Contacts).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. OAuth2 Autenticación",
      "item": [
        {
          "name": "Obtener Access Token (OAuth2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"suitecrm_token\", jsonData.access_token);",
                  "    console.log(\"¡Token de SuiteCRM V8 guardado exitosamente en la variable suitecrm_token!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{suitecrm_url}}/access_token",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "access_token"
              ]
            },
            "description": "Genera el token de acceso OAuth2 usando el grant_type password. El token se almacena automáticamente en 'suitecrm_token'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Categorías y Subcategorías (AOS_Product_Categories)",
      "item": [
        {
          "name": "Listar Todas las Categorías y Subcategorías",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{suitecrm_url}}/V8/module/AOS_Product_Categories",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module",
                "AOS_Product_Categories"
              ]
            },
            "description": "Obtiene la lista completa de categorías y subcategorías creadas en SuiteCRM."
          },
          "response": []
        },
        {
          "name": "Listar Categorías Principales (Padres)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{suitecrm_url}}/V8/module/AOS_Product_Categories?filter[is_parent][eq]=1",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module",
                "AOS_Product_Categories"
              ],
              "query": [
                {
                  "key": "filter[is_parent][eq]",
                  "value": "1"
                }
              ]
            },
            "description": "Filtra únicamente las categorías raices o principales (donde is_parent = 1)."
          },
          "response": []
        },
        {
          "name": "Listar Subcategorías por ID de Categoría Padre",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{suitecrm_url}}/V8/module/AOS_Product_Categories?filter[parent_category_id][eq]={{parent_category_id}}",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module",
                "AOS_Product_Categories"
              ],
              "query": [
                {
                  "key": "filter[parent_category_id][eq]",
                  "value": "{{parent_category_id}}"
                }
              ]
            },
            "description": "Obtiene las subcategorías que pertenecen a una categoría padre específica."
          },
          "response": []
        },
        {
          "name": "Obtener Detalle de una Categoría",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{suitecrm_url}}/V8/module/AOS_Product_Categories/{{category_id}}",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module",
                "AOS_Product_Categories",
                "{{category_id}}"
              ]
            },
            "description": "Obtiene la información y atributos detallados de una categoría por su ID."
          },
          "response": []
        },
