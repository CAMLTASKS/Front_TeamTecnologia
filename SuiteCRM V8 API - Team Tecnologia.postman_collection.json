          "response": []
        },
        {
          "name": "Crear Nueva Subcategoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/vnd.api+json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"type\": \"AOS_Product_Categories\",\n    \"attributes\": {\n      \"name\": \"Juegos de Llaves y Dados\",\n      \"is_parent\": 0,\n      \"parent_category_id\": \"{{parent_category_id}}\",\n      \"description\": \"Subcategoría para sets de llaves mixtas y dados de impacto\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{suitecrm_url}}/V8/module",
              "host": [
                "{{suitecrm_url}}"
              ],
              "path": [
                "V8",
                "module"
              ]
            },
            "description": "Crea una subcategoría asociada a una categoría padre."
